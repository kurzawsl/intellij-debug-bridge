{
	"info": {
		"_postman_id": "debug-bridge-collection",
		"name": "IntelliJ Debug Bridge",
		"description": "REST API for controlling IntelliJ debugger from external tools (MCP, AI assistants, etc.)\n\nBase URL: http://127.0.0.1:19999\n\n## API Versions\n\n### V1 API (Legacy)\nEndpoints under `/debug/*` - works with the currently active session.\nBest for single-project debugging.\n\n### V2 API (Multi-Project)\nEndpoints under `/projects/*` and `/sessions/*` - explicitly target projects and sessions by ID.\nBest for debugging multiple microservices simultaneously.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://127.0.0.1:19999",
			"type": "string"
		},
		{
			"key": "sessionId",
			"value": "",
			"type": "string",
			"description": "UUID of the debug session (get from /sessions)"
		},
		{
			"key": "projectId",
			"value": "",
			"type": "string",
			"description": "ID of the project (get from /projects)"
		}
	],
	"item": [
		{
			"name": "Health & Status",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/health",
							"host": ["{{baseUrl}}"],
							"path": ["health"]
						},
						"description": "Check if Debug Bridge server is running"
					}
				},
				{
					"name": "Service Info",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/",
							"host": ["{{baseUrl}}"],
							"path": [""]
						},
						"description": "Get service info and version"
					}
				}
			]
		},
		{
			"name": "V2 - Discovery",
			"description": "V2 API endpoints for discovering projects and sessions",
			"item": [
				{
					"name": "List All Projects",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.projects && jsonData.projects.length > 0) {",
									"    pm.collectionVariables.set('projectId', jsonData.projects[0].id);",
									"    console.log('Set projectId to: ' + jsonData.projects[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects",
							"host": ["{{baseUrl}}"],
							"path": ["projects"]
						},
						"description": "List all open projects in IntelliJ. Returns project IDs that can be used for project-scoped operations.\n\nResponse includes:\n- id: Stable project ID (SHA-256 hash of path)\n- name: Project display name\n- path: Project directory path\n- sessionCount: Number of active debug sessions"
					}
				},
				{
					"name": "List All Sessions",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.sessions && jsonData.sessions.length > 0) {",
									"    pm.collectionVariables.set('sessionId', jsonData.sessions[0].id);",
									"    console.log('Set sessionId to: ' + jsonData.sessions[0].id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions",
							"host": ["{{baseUrl}}"],
							"path": ["sessions"]
						},
						"description": "List all active debug sessions across all projects.\n\nResponse includes:\n- id: Session UUID\n- name: Session/configuration name\n- projectId: Parent project ID\n- projectName: Parent project name\n- status: RUNNING, SUSPENDED, or TERMINATED\n- location: Current debug location (if suspended)"
					}
				}
			]
		},
		{
			"name": "V2 - Session Operations",
			"description": "V2 API endpoints for controlling specific debug sessions by ID",
			"item": [
				{
					"name": "Get Session Details",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}"]
						},
						"description": "Get detailed information about a specific debug session including current location and stack trace."
					}
				},
				{
					"name": "Get Session Variables",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}/variables",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}", "variables"]
						},
						"description": "Get local variables and 'this' object for a specific session."
					}
				},
				{
					"name": "Step Over (Session)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}/step-over",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}", "step-over"]
						},
						"description": "Execute step over (F8) in the specified session."
					}
				},
				{
					"name": "Step Into (Session)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}/step-into",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}", "step-into"]
						},
						"description": "Execute step into (F7) in the specified session."
					}
				},
				{
					"name": "Step Out (Session)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}/step-out",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}", "step-out"]
						},
						"description": "Execute step out (Shift+F8) in the specified session."
					}
				},
				{
					"name": "Resume (Session)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}/resume",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}", "resume"]
						},
						"description": "Resume execution (F9) in the specified session."
					}
				},
				{
					"name": "Pause (Session)",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}/pause",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}", "pause"]
						},
						"description": "Pause execution in the specified session."
					}
				},
				{
					"name": "Evaluate Expression (Session)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"expression\": \"myVariable.toString()\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}/evaluate",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}", "evaluate"]
						},
						"description": "Evaluate an expression in the context of the specified session."
					}
				},
				{
					"name": "Stop Session",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/sessions/{{sessionId}}",
							"host": ["{{baseUrl}}"],
							"path": ["sessions", "{{sessionId}}"]
						},
						"description": "Stop the specified debug session."
					}
				}
			]
		},
