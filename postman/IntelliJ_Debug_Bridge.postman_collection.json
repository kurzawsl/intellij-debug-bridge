				{
					"name": "Add Project Breakpoint",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"file\": \"MyClass.java\",\n    \"line\": 42,\n    \"condition\": \"x > 10\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/projects/{{projectId}}/breakpoints",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{projectId}}", "breakpoints"]
						},
						"description": "Add a breakpoint in a specific project."
					}
				},
				{
					"name": "Remove Project Breakpoint",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"file\": \"MyClass.java\",\n    \"line\": 42\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/projects/{{projectId}}/breakpoints",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{projectId}}", "breakpoints"]
						},
						"description": "Remove a breakpoint from a specific project."
					}
				},
				{
					"name": "Start Debug in Project",
					"request": {
						"method": "POST",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/projects/{{projectId}}/debug/start?config=MyConfiguration",
							"host": ["{{baseUrl}}"],
							"path": ["projects", "{{projectId}}", "debug", "start"],
							"query": [
								{
									"key": "config",
									"value": "MyConfiguration",
									"description": "Optional: specific configuration name"
								}
							]
						},
						"description": "Start a debug session in a specific project. Optionally specify a configuration name."
					}
				}
			]
		},
		{
			"name": "V1 - Debug State (Legacy)",
